  m_Script: {fileID: 11500000, guid: 281b790b0324bdb49aca9bbad878a09c, type: 3}
  m_Name: "Policia_Conversaci\xF3n"
  m_EditorClassIdentifier: 
  actionId: Conversacion_Policia_1
  dialogues:
  - speakerName: Nyssa
    content: Hello, I am here to report a missing person. It's a friend of mine,
      she hasn't been coming to class for a week and is not answering my calls. I
      am very worried.
  - speakerName: Police Officer
    content: Could you give me their name, description and any other information
      that might help us?
  - speakerName: Nyssa
    content: Yes, her name is <Bold>(Umi)</Bold>. She is thin, has brown hair with
      bangs and is my age.
  - speakerName: Police Officer
    content: 'Do you know if she was having problems with anyone or if there was
      <Bold>(anything unusual)</Bold> in his life lately?

'
  - speakerName: Nyssa
    content: 'No... She had no enemies or bad habits. The last thing I know from
      her is a <Bold>(mail)</Bold> that she left me before going out of her house.

'
  - speakerName: Police Officer
    content: 'Hmmm... There have been some reports of people  who have inexplicably
      disappeared, same as 10 years ago.


'
  - speakerName: Nyssa
    content: 'My mother! She is still missing... She left no trace and no clues.
      Please, may I know how your investigation is going?

'
  - speakerName: Police Officer
    content: 'I''m not sure....

'
  - speakerName: Nyssa
    content: "Please tell me something!  \n"
  dialogueOptions:
  - optionText: Empathy
    actionId: Option_1
    requiresDiceRoll: 1
