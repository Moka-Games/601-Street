  m_Script: {fileID: 11500000, guid: 281b790b0324bdb49aca9bbad878a09c, type: 3}
  m_Name: Daichi_Parque_PostSecta_Fracaso_2
  m_EditorClassIdentifier: 
  actionId: Daichi_Parque_PostSecta_Fracaso
  dialogues:
  - speakerName: Daichi
    content: "Well, well! So you actually managed to open the little box? I\u2019m
      impressed I thought you\u2019d still be crying in the bushes by now."
  - speakerName: Nyssa
    content: I did what you asked for. Now what?
  - speakerName: Daichi
    content: You're so impatient... But hey, I guess you've earned it.
  - speakerName: Daichi
    content: "Listen carefully: you need to go to an old abandoned house. It\u2019s
      down the path to the right from the center of the park.\r\n"
  - speakerName: Daichi
    content: "The one that looks like it came straight out of a cheap horror movie.
      I\u2019m sure you know which one.\r\n"
  - speakerName: Daichi
    content: "Inside, you\u2019ll find more answers\u2026 or more questions. That
      depends on how clever you are. But be careful, Nyssa.\r\n"
  - speakerName: Daichi
    content: "Oye\u2026 si desapareces esta vez. I promise not laughing at all."
  dialogueOptions: []
