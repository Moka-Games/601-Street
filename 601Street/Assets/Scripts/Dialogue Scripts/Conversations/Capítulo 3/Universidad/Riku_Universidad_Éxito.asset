  m_Script: {fileID: 11500000, guid: 281b790b0324bdb49aca9bbad878a09c, type: 3}
  m_Name: "Riku_Universidad_\xC9xito"
  m_EditorClassIdentifier: 
  actionId: "Riku_Parque_\xC9xito"
  dialogues:
  - speakerName: Riku
    content: "My parents\u2026 They used to talk about something important when I
      was little, some kind of power, but I was too young to understand any of it.
      I don\u2019t remember much\u2026 they died a few years later."
  - speakerName: Riku
    content: "Let me think\u2026 In their notebook, there was something about the
      beginning of it all.\nQuick, Nyssa where did it all start? At School?"
  - speakerName: Riku
    content: All right, you've convinced me, I'll go with you to the portal, although
      I have some things to do first, I'll see you there.
  dialogueOptions: []
